{
  "name": "mcp-connector-check",
  "version": "0.1.0",
  "description": "Check a remote MCP server (custom Claude connector or ChatGPT app) for production readiness and security. CLI and MCP server.",
  "mcpName": "io.github.prestyj/mcp-connector-check",
  "type": "module",
  "bin": {
    "mcp-connector-check": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude",
    "claude-connector",
    "chatgpt-apps",
    "security",
    "oauth",
    "linter",
    "audit"
  ],
  "author": "Prestyj (https://prestyj.com)",
  "homepage": "https://prestyj.com/connectors/mcp-server-security-checklist",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prestyj/mcp-connector-check.git"
  },
  "bugs": {
    "url": "https://github.com/prestyj/mcp-connector-check/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
